CREATE view [cus].[v_total_data] as
With ad as (
select
	Channel as Platform,
	'Paid' as Paid_Total,
	Date,
	Product_ID,
	[Item Name],
	GMV,
	Expense,
	Conversions as Orders,
	[Items Sold],
	Ads_name,
	Ads_Type as Ads_type,
	Ads_Category as Ads_category,
	Clicks,
	Impression,
	NULL as Status,
	NULL as Order_ID,
	NULL as [Reach],
	NULL as [Campaign name] ,
	NULL as [Campaign Budget],
	NULL as [Campaign Budget Type],
	NULL as [Starts],
	NULL as [Ends],
	NULL as [Reporting starts],
	NULL as [Reporting ends],
	NULL as Add_to_cart,
	NULL as [Livestream name],
	NULL as [conversion ID],
	[Placement]
from db.cus.v_Ads_Performance
UNION ALL 
select
	'Shopee' as Platform,
	'Paid' as Paid_Total,
	Convert(date, [Thời gian mua]) as Date, 
	--[Mã sản phẩm] as Product_ID,
	CASE 
        WHEN CHARINDEX('-', [Mã sản phẩm]) > 0 
            THEN LEFT([Mã sản phẩm], CHARINDEX('-', [Mã sản phẩm]) - 1)
        ELSE [Mã sản phẩm]
    END AS Product_ID,
	[Sản phẩm] as Item_name,
	[Giá sản phẩm] as GMV,
	[Hoa hồng] as Expense,
	NULL as Orders,
	NULL as [Items Sold],
	NULL as Ads_name,
	NULL as Ads_type,
	'Affiliate MasOffer' as Ads_category,
	NULL as Clicks,
	NULL as Impression,
	--[Trạng thái] as Status,
	NULL as Status,
	[Mã đơn hàng] as Order_ID,
	NULL as [Reach],
	NULL as [Campaign name] ,
	NULL as [Campaign Budget],
	NULL as [Campaign Budget Type],
	NULL as [Starts],
	NULL as [Ends],
	NULL as [Reporting starts],
	NULL as [Reporting ends],
	NULL as Add_to_cart,
	NULl as [Livestream name],
	[conversion ID],
	NULL as Placement
from db.dbo.v_Shopee_affiliate_masoffer
UNION ALL
select
	'Shopee' as Platform,
	'Paid' as Paid_Total,
	[Reporting starts] as Date,
	NULL as [Product_ID],
	NULL as [Item Name],
	[Mobile app purchases conversion value for shared items only] as GMV,
	[Amount spent (VND)] as Expense,
	[Mobile app purchases with shared items] as Orders,
	NULL as [Items Sold],
	NULL as Ads_name,
	[Objective] as Ads_type,
	'Facebook Ads' as Ads_category,
	[Link clicks] as Clicks,
	[Impressions]as Impression,
	NULL as Status,
	NULL as Order_ID,	
	[Reach],
	[Campaign name] ,
	[Campaign Budget],
	[Campaign Budget Type],
	[Starts],
	[Ends],
	[Reporting starts],
	[Reporting ends],
	[Mobile app adds to cart with shared items] as Add_to_cart,
	NULL as [Livestream name],
	NULL as [conversion ID],
	NULL as Placement
from db.cus.vv_Shopee_facebook_ads 
UNION ALL 
select
	'ShopeeLive' as [Platform],
	'Paid' as Paid_Total,
	[Date],
	[Item ID] as Product_ID,
	[Product Information] as [Item Name],
	[Sales(Confirmed Orders)] as GMV,
	NULL as Expense,
	[Orders (Confirmed Orders)] as Orders,
	NULL as [Items Sold],
	NULL as Ads_name,
	NULL as Ads_type,
	'ShopeeLive' as Ads_category,
	[Clicks] as Clicks,
	NULL as Impression,
	NULL as Status,
	NULL as Order_ID,	
	NULL as [Reach],
	NULL as [Campaign name] ,
	NULL as [Campaign Budget],
	NULL as [Campaign Budget Type],
	NULL as [Starts],
	NULL as [Ends],
	NULL as [Reporting starts],
	NULL as [Reporting ends],
	[Units (Add to Cart)] as Add_to_cart,
	[Livestream name],
	NULL as [conversion ID],
	NULL as Placement
from db.dbo.v_Shopee_livestream
UNION ALL
select
	'Shopee' as Platform,
	'Paid' as Paid_Total,
	Date, 
	NULL as Product_ID,
	NULL as Item_name,
	GMV,
	Expense,
	Orders,
	NULL as [Items Sold],
	NULL as Ads_name,
	'LiveAds' as Ads_type,
	'Ads' as Ads_category,
	NULL as Clicks,
	[Views] as Impression,
	--[Status] as Status,
	NULL as Status,
	NULL as Order_ID,
	NULL as [Reach],
	[Campaign Name] as [Campaign name] ,
	[Budget] as [Campaign Budget],
	NULL as [Campaign Budget Type],
	[Start Date] as [Starts],
	[End Date] as [Ends], --không cần đổi lại date format dạng yyyy-MM-dd do đang ở dạng string (có TH: "Unlimited")
	NULL as [Reporting starts],
	NULL as [Reporting ends],
	NULL as Add_to_cart,
	[Campaign Name] as [Livestream name],
	NULL as [conversion ID],
	NULL as Placement
from db.[cus].[v_Shopee_ADS_LiveAds]
)
