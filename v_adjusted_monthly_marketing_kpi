------------create a function to unpivot raw data -------------
CREATE function [cus].[fn_unpivot_mkt_plan] (@metrics nvarchar(50))
returns table
as
Return
	(
		select ROW_NUMBER() over (order by (select null ) ) as id, [Tháng] as 'Month', Value
		from (
			select
			*
			from db.cus.[Monthly_KPI_Marketing]
			where [Month] = @metrics
			) as tb1
		unpivot (
			Value for [Tháng] in ([04-2025] , [05-2025] , [06-2025], [07-2025], [08-2025], [09-2025] , [10-2025], [11-2025], [12-2025], [01-2026], [02-2026], [03-2026] )  
			) as unpvt
);
GO


----------- create a new transformed view (monthly marketing plan) -------------
create view [cus].[v_adjusted_monthly_mkt_kpi] as 
select
t1.id
,t1.month
,t1.Value as GMV
,t2.Value as NMV
,t3.Value as PaidGMV
,t4.Value as OrganicGMV
,t5.Value as ROAS
,t6.Value as Visitor
,t7.Value as Buyer
,t8.Value as Orderr
,t9.Value as AOV
,t10.Value as AOB
,t11.Value as CVR
,coalesce(t12.Value,0) as Onsite_spending
,coalesce(t13.Value,0) as Affiliate_spending
,coalesce(t14.Value,0) as Offsite_spending
,coalesce(t15.Value,0) as Livestream_spending
,coalesce(t16.Value,0) as OtherFee
from cus.fn_unpivot_mkt_plan('GMV') t1 
join cus.fn_unpivot_mkt_plan('NMV') t2 on t1.id = t2.id
join cus.fn_unpivot_mkt_plan('Paid GMV') t3 on t1.id = t3.id
join cus.fn_unpivot_mkt_plan('Organic GMV') t4 on t1.id = t4.id
join cus.fn_unpivot_mkt_plan('ROAS') t5 on t1.id = t5.id
join cus.fn_unpivot_mkt_plan('Visitor') t6 on t1.id = t6.id
join cus.fn_unpivot_mkt_plan('Buyer') t7 on t1.id = t7.id
join cus.fn_unpivot_mkt_plan('Order') t8 on t1.id = t8.id
join cus.fn_unpivot_mkt_plan('AOV') t9 on t1.id = t9.id
join cus.fn_unpivot_mkt_plan('AOB') t10 on t1.id = t10.id
join cus.fn_unpivot_mkt_plan('CVR') t11 on t1.id = t11.id
join cus.fn_unpivot_mkt_plan('Onsite platform') t12 on t1.id = t12.id
join cus.fn_unpivot_mkt_plan('Affiliate') t13 on t1.id = t13.id
join cus.fn_unpivot_mkt_plan('Offsite platform') t14 on t1.id = t14.id
join cus.fn_unpivot_mkt_plan('Livestream') t15 on t1.id = t15.id
join cus.fn_unpivot_mkt_plan('Total Fee') t16 on t1.id = t16.id
GO
